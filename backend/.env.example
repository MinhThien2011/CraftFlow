# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
# You can choose one of the following based on your environment
MONGO_URI_LOCAL=mongodb://localhost:27017/craftflow
MONGO_URI_ATLAS=
MONGO_URI_RAILWAY=

# Database Name (used for initialization)
DB_NAME=craftflow

# Security & JWT
# IMPORTANT: Change this secret in production
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS Configuration (optional)
# CLIENT_URL=http://localhost:5173
