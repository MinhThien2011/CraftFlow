# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
# You can choose one of the following based on your environment
MONGO_URI_LOCAL=mongodb://localhost:27017/craftflow
MONGO_URI_ATLAS=
MONGO_URI_RAILWAY=

# Database Name (used for initialization)
DB_NAME=craftflow

# Security & JWT
# IMPORTANT: Change this secret in production
JWT_SECRET=my_jwt_secret
JWT_EXPIRES_IN=7d

# Gemini API Configuration
GEMINI_API_KEY=
AI_MODEL_PRIMARY=gemini-3-flash-preview
AI_MODEL_FALLBACKS=gemini-2.0-flash
AI_FALLBACK_MAX_ATTEMPTS=3
AI_RISK_HOURS_THRESHOLD=24
AI_LOG_VERBOSE=false
AI_ERROR_STACK=false
AI_GUARD_FAIL_CLOSED=false
# Optional override for guard classifier model chain
# AI_GUARD_MODEL_PRIMARY=
# AI_GUARD_MODEL_FALLBACKS=
# AI_GUARD_MAX_ATTEMPTS=3
# AI_GUARD_POLICY=

# CORS Configuration (optional)
# CLIENT_URL=http://localhost:5173

# Cloudinary Configuration
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limit
IP_WHITELIST=127.0.0.1

# Logging
LOG_LEVEL=info
REDIS_LOG_GOOD_LATENCY=false
SLOW_REQUEST_MS=500
SLOW_REQUEST_SAMPLE_RATE=1
